DJANGO_SECRET_KEY=summarease-local-dev-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Google Gemini API configuration.
# Get your API key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_google_api_key
# GEMINI_MODEL=gemini-2.0-flash

# Uncomment to use MySQL instead of SQLite.
# DB_ENGINE=mysql
# DB_NAME=summarease_django
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=

# Uncomment to use SQL Server instead of SQLite.
# DB_ENGINE=sqlserver
# DB_NAME=SummarEase_Django
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=your_password
# DB_DRIVER=ODBC Driver 17 for SQL Server

# CORS (frontend domains, comma-separated).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis cache (optional — falls back to LocMemCache).
# REDIS_URL=redis://127.0.0.1:6379/0

# Production overrides.
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=warning
